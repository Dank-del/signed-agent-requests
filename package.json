{
  "name": "signed-agent-requests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "SAR (Signed Agent Requests): a strict Web Bot Auth profile, signer SDK, verifier, and Bun HTTPS pilot",
  "license": "MIT",
  "author": "Sayan Biswas",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "files": ["dist/", "README.md", "LICENSE", "docs/protocol.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "demo:setup": "bun demo/setup.ts",
    "demo": "bun demo/server.ts",
    "demo:request": "bun demo/client.ts",
    "check": "bun run typecheck && bun test && bun run build",
    "check:sdks": "bun interop/check.ts"
  },
  "dependencies": {
    "http-message-signatures": "1.0.6",
    "structured-headers": "2.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
